<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ChzzkApi-CS" Version="1.0.1" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.SDL3" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.OpenGL3" Version="1.1.0" />
    <PackageReference Include="SDL3-CS" Version="3.4.18.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glitzk.Player\Glitzk.Player.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ProjectReference Include="..\Glitzk.Player.WebView2\Glitzk.Player.WebView2.csproj" />
  </ItemGroup>

  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- The outer multi-target build also runs Build with an empty OutDir, which would write into the project folder. -->
  <Target Name="GenerateThirdPartyNotices" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' != ''">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet nuget-license -i &quot;$(MSBuildProjectFullPath)&quot; -t -d &quot;$(OutDir)licenses&quot; -o Table -fo &quot;$(OutDir)THIRD-PARTY-NOTICES.txt&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- nuget-license reads package metadata only, so the native libraries bundled in those packages need their notices copied by hand. -->
    <ItemGroup>
      <NativeLicense Include="licenses-native\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLicense)" DestinationFolder="$(OutDir)licenses" />
  </Target>
  
</Project>
